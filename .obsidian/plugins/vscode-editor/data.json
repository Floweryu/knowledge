{
  "extensions": [
    "ts",
    "js",
    "py",
    "css",
    "c",
    "cpp",
    "go",
    "rs",
    "java",
    "lua",
    "php",
    "cs",
    "txt",
    "log",
    "json",
    "xml",
    "yaml",
    "yml",
    "ini",
    "csv"
  ],
  "folding": true,
  "lineNumbers": true,
  "wordWrap": true,
  "minimap": true,
  "semanticValidation": true,
  "syntaxValidation": true,
  "themeColor": "AUTO",
  "fontSize": 12,
  "fontFamily": "Menlo, Monaco, 'Courier New', monospace",
  "fontLigatures": true
}